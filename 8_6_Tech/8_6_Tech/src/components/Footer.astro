---
---

<footer class="bg-[#050505] border-t border-white/5 py-16 relative overflow-hidden">
  <!-- Background decor -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(212,175,55,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(212,175,55,0.03)_1px,transparent_1px)] bg-[size:60px_60px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 relative z-10">
    <!-- Top Row: Brand + Nav -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-10 pb-10 border-b border-white/5">
      
      <!-- Brand -->
      <div class="max-w-xs">
        <a href="#" class="text-2xl font-display font-extrabold tracking-wider text-white">
          CR7<span class="text-gold-700">.</span>LEGEND
        </a>
        <p class="text-xs text-gray-500 mt-3 leading-relaxed font-sans">
          Trang web tôn vinh hành trình phi thường của Cristiano Ronaldo — người đàn ông đã tự tay viết lên định nghĩa của sự vĩ đại trong bóng đá.
        </p>
      </div>

      <!-- Quick Nav -->
      <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <a href="#about" class="text-gray-400 hover:text-gold-700 transition-colors font-sans">Giới thiệu</a>
        <a href="#stats" class="text-gray-400 hover:text-gold-700 transition-colors font-sans">Thống kê</a>
        <a href="#timeline" class="text-gray-400 hover:text-gold-700 transition-colors font-sans">Hành trình</a>
        <a href="#quotes" class="text-gray-400 hover:text-gold-700 transition-colors font-sans">Di sản</a>
      </nav>
    </div>

    <!-- Middle Row: Stats Highlight -->
    <div class="py-10 border-b border-white/5">
      <p class="text-center text-xs uppercase tracking-widest text-gray-600 font-sans mb-6">Tóm tắt thống kê</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {[
          { num: "900+", label: "Bàn thắng" },
          { num: "5", label: "Champions League" },
          { num: "5", label: "Quả Bóng Vàng" },
          { num: "200+", label: "Trận ĐTQG" },
        ].map(item => (
          <div>
            <span class="block text-xl font-display font-bold text-white">{item.num}</span>
            <span class="text-[10px] uppercase tracking-wider text-gray-500 font-sans">{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Row: Credits + Back to Top -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-600 font-sans text-center md:text-left">
        © 2025 <span class="text-gray-400">8_6_Tech</span>. Trang web được xây dựng với 
        <span class="text-gold-700"> Astro</span> &amp; 
        <span class="text-gold-700"> Tailwind CSS</span>. Nội dung mang mục đích giáo dục &amp; tôn vinh.
      </p>

      <a href="#" id="back-to-top" class="flex items-center gap-2 text-xs text-gray-500 hover:text-gold-700 transition-colors group font-sans">
        <span>Về đầu trang</span>
        <span class="w-8 h-8 rounded-full border border-white/10 group-hover:border-gold-700 flex items-center justify-center transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</footer>

<script>
  document.getElementById('back-to-top')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
