---
const stats = [
  {
    number: "900+",
    label: "BÀN THẮNG SỰ NGHIỆP",
    description: "Cầu thủ ghi bàn vĩ đại nhất lịch sử bóng đá thế giới được FIFA công nhận.",
    icon: "⚽",
    color: "from-gold-800/20 to-gold-950/20"
  },
  {
    number: "250+",
    label: "KIẾN TẠO THÀNH CÔNG",
    description: "Chứng minh tầm ảnh hưởng toàn diện lên lối chơi tập thể qua nhiều năm tháng.",
    icon: "👟",
    color: "from-neutral-900 to-neutral-950"
  },
  {
    number: "5",
    label: "QUẢ BÓNG VÀNG",
    description: "Sự ghi nhận tối thượng cho vị thế cầu thủ xuất sắc nhất thế giới (2008, 2013, 2014, 2016, 2017).",
    icon: "🏆",
    color: "from-gold-800/20 to-gold-950/20"
  },
  {
    number: "5",
    label: "CHAMPIONS LEAGUE",
    description: "Ông vua của đấu trường danh giá nhất châu Âu (1 cùng Man Utd, 4 cùng Real Madrid).",
    icon: "⭐",
    color: "from-neutral-900 to-neutral-950"
  },
  {
    number: "4",
    label: "CHIẾC GIÀY VÀNG CHÂU ÂU",
    description: "Giải thưởng danh giá dành cho cầu thủ ghi nhiều bàn thắng nhất các giải VĐQG châu Âu.",
    icon: "⚜️",
    color: "from-gold-800/20 to-gold-950/20"
  },
  {
    number: "200+",
    label: "TRẬN ĐẤU QUỐC TẾ",
    description: "Kỷ lục thế giới về số lần khoác áo đội tuyển quốc gia Bồ Đào Nha.",
    icon: "🇵🇹",
    color: "from-neutral-900 to-neutral-950"
  }
];
---

<section id="stats" class="py-24 relative overflow-hidden bg-[#050505] border-y border-white/5">
  <!-- Decorative glowing lines -->
  <div class="absolute left-10 top-1/4 w-[1px] h-96 bg-gradient-to-b from-gold-700/20 to-transparent"></div>
  <div class="absolute right-10 bottom-1/4 w-[1px] h-96 bg-gradient-to-t from-gold-700/20 to-transparent"></div>

  <div class="max-w-6xl mx-auto px-4 relative z-10">
    <!-- Section Title -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-gold-700 font-sans block mb-3">CON SỐ BIẾT NÓI</span>
      <h2 class="text-3xl md:text-5xl font-display font-black text-white mb-4">
        Kỷ Lục Vô Song Của <span class="text-gradient-gold">CR7</span>
      </h2>
      <p class="text-gray-400 text-sm md:text-base font-sans font-light">
        Những con số thống kê chứng minh đẳng cấp bền bỉ vượt thời gian và sự thống trị tuyệt đối của Ronaldo tại các giải đấu đỉnh cao.
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {stats.map((stat) => (
        <div class="group relative rounded-2xl p-6 glass-panel border border-white/5 glow-gold-hover transition-all duration-300 overflow-hidden flex flex-col justify-between min-h-[200px]">
          <!-- Top Row with icon and hover backdrop glow -->
          <div class="absolute -top-12 -right-12 w-24 h-24 rounded-full bg-gold-700/5 group-hover:bg-gold-700/10 group-hover:scale-150 transition-all duration-500 blur-xl"></div>
          
          <div class="flex items-start justify-between">
            <span class="text-4xl font-display font-black text-white group-hover:text-gold-700 transition-colors duration-300">
              {stat.number}
            </span>
            <span class="text-2xl opacity-60 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300">
              {stat.icon}
            </span>
          </div>

          <!-- Bottom Row with details -->
          <div class="mt-8 relative z-10">
            <h3 class="text-sm font-display font-bold text-white tracking-wider mb-2 uppercase group-hover:text-gold-500 transition-colors duration-300">
              {stat.label}
            </h3>
            <p class="text-xs text-gray-500 leading-relaxed font-sans font-light group-hover:text-gray-400 transition-colors duration-300">
              {stat.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Sub-info: Club Stats vs International Stats -->
    <div class="mt-16 p-6 md:p-8 rounded-2xl glass-panel-gold border border-gold-700/20 bg-gradient-to-r from-black/80 to-gold-950/10 flex flex-col md:flex-row justify-between items-center gap-8 shadow-xl">
      <div class="max-w-xl">
        <h4 class="text-lg font-display font-bold text-white mb-2">Thống trị cả cấp câu lạc bộ lẫn đội tuyển quốc gia</h4>
        <p class="text-xs text-gray-400 font-sans font-light leading-relaxed">
          Ronaldo là cầu thủ duy nhất ghi bàn ở 5 kỳ EURO khác nhau, 5 kỳ World Cup khác nhau, đồng thời sở hữu kỷ lục ghi bàn ở nhiều trận chung kết Champions League nhất.
        </p>
      </div>
      <div class="flex gap-4 shrink-0">
        <div class="px-6 py-3 rounded-xl border border-white/10 glass-panel text-center">
          <span class="block text-2xl font-display font-bold text-white">770+</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-500 font-sans">Bàn thắng CLB</span>
        </div>
        <div class="px-6 py-3 rounded-xl border border-gold-700/20 glass-panel-gold text-center">
          <span class="block text-2xl font-display font-bold text-gold-700">130+</span>
          <span class="text-[9px] uppercase tracking-wider text-gold-500 font-sans">Bàn thắng ĐTQG</span>
        </div>
      </div>
    </div>
  </div>
</section>
