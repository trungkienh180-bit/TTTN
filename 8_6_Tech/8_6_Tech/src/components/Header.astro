---
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 w-[90%] max-w-6xl z-50 transition-all duration-300">
  <div class="glass-panel px-6 py-4 rounded-2xl flex items-center justify-between shadow-xl shadow-black/40">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-2 group">
      <span class="text-2xl font-display font-extrabold tracking-wider text-white group-hover:text-gradient-gold transition-colors duration-300">
        CR7<span class="text-gold-700">.</span>LEGEND
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
      <a href="#about" class="text-gray-400 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-gold-700 after:transition-all hover:after:w-full">Giới thiệu</a>
      <a href="#stats" class="text-gray-400 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-gold-700 after:transition-all hover:after:w-full font-sans">Thống kê</a>
      <a href="#timeline" class="text-gray-400 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-gold-700 after:transition-all hover:after:w-full">Hành trình</a>
      <a href="#quotes" class="text-gray-400 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-gold-700 after:transition-all hover:after:w-full">Di sản</a>
    </nav>

    <!-- Right Side CTA -->
    <div class="hidden md:block">
      <a href="#stats" class="px-5 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider text-black bg-gold-700 hover:bg-gold-500 shadow-md shadow-gold-700/20 hover:scale-[1.03] transition-all duration-300">
        Khám phá thống kê
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="menu-toggle" class="md:hidden flex flex-col justify-between w-6 h-4 text-white focus:outline-none" aria-label="Toggle menu">
      <span class="w-full h-[2px] bg-white rounded-lg transition-transform duration-300 origin-left"></span>
      <span class="w-full h-[2px] bg-white rounded-lg transition-opacity duration-300"></span>
      <span class="w-full h-[2px] bg-white rounded-lg transition-transform duration-300 origin-left"></span>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden absolute top-20 left-0 w-full glass-panel-gold rounded-2xl p-6 flex-col gap-4 shadow-2xl animate-fade-in md:hidden">
    <a href="#about" class="mobile-link text-lg font-medium py-2 text-gray-300 hover:text-gold-700 transition-colors border-b border-white/5">Giới thiệu</a>
    <a href="#stats" class="mobile-link text-lg font-medium py-2 text-gray-300 hover:text-gold-700 transition-colors border-b border-white/5">Thống kê</a>
    <a href="#timeline" class="mobile-link text-lg font-medium py-2 text-gray-300 hover:text-gold-700 transition-colors border-b border-white/5">Hành trình</a>
    <a href="#quotes" class="mobile-link text-lg font-medium py-2 text-gray-300 hover:text-gold-700 transition-colors">Di sản</a>
    <a href="#stats" class="mobile-link w-full py-3 mt-2 rounded-xl text-center font-semibold text-black bg-gold-700 hover:bg-gold-500 transition-all duration-300">
      Xem Thống Kê
    </a>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const lines = menuToggle?.querySelectorAll('span');

  menuToggle?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    
    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      mobileMenu?.classList.add('flex');
      // Animate hamburger
      if (lines) {
        lines[0].style.transform = 'rotate(45deg) translate(2px, -1px)';
        lines[1].style.opacity = '0';
        lines[2].style.transform = 'rotate(-45deg) translate(2px, 1px)';
      }
    } else {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
      // Reset hamburger
      if (lines) {
        lines[0].style.transform = 'none';
        lines[1].style.opacity = '1';
        lines[2].style.transform = 'none';
      }
    }
  });

  // Close menu on link click
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
      if (lines) {
        lines[0].style.transform = 'none';
        lines[1].style.opacity = '1';
        lines[2].style.transform = 'none';
      }
    });
  });

  // Header scroll effect
  window.addEventListener('scroll', () => {
    const header = document.querySelector('header');
    if (window.scrollY > 50) {
      header?.classList.add('top-2');
      header?.querySelector('.glass-panel')?.classList.add('py-3', 'bg-[#0a0a0a]/80');
    } else {
      header?.classList.remove('top-2');
      header?.querySelector('.glass-panel')?.classList.remove('py-3', 'bg-[#0a0a0a]/80');
    }
  });
</script>
