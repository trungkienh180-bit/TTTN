---
---

<section class="relative min-h-screen flex items-center justify-center pt-28 pb-16 px-4 overflow-hidden bg-radial from-[#15120a] via-[#050505] to-[#050505]">
  <!-- Background Glow & Particles -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-gold-700/10 blur-[120px] animate-pulse-slow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] rounded-full bg-gold-700/5 blur-[150px] animate-pulse-slow" style="animation-delay: 3s;"></div>
    
    <!-- Stadium/Football Net Abstract Mesh Overlay -->
    <div class="absolute inset-0 opacity-10 bg-[linear-gradient(rgba(212,175,55,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(212,175,55,0.1)_1px,transparent_1px)] bg-[size:40px_40px]"></div>
  </div>

  <div class="relative z-10 w-full max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <!-- Left Column: Copy & Actions -->
    <div class="lg:col-span-7 text-center lg:text-left">
      <!-- Tag -->
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-gold-700/30 bg-gold-950/20 text-gold-500 text-xs font-semibold tracking-widest uppercase mb-6 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-gold-700 animate-ping"></span>
        Huyền Thoại Bất Tử Của Bóng Đá Thế Giới
      </span>

      <!-- Title -->
      <h1 class="text-5xl md:text-7xl font-display font-black tracking-tight text-white mb-6">
        CRISTIANO <br />
        <span class="text-gradient-gold">RONALDO</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-gray-400 text-base md:text-lg max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed font-sans font-light">
        Biểu tượng tối thượng của ý chí vươn lên, sự khổ luyện không ngừng nghỉ và khát vọng chinh phục đỉnh cao. Từ hòn đảo Madeira nghèo khó đến vị thế Cầu thủ ghi nhiều bàn thắng nhất lịch sử bóng đá thế giới.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-12">
        <a href="#stats" class="px-8 py-4 rounded-xl text-sm font-bold uppercase tracking-wider text-black bg-gold-700 hover:bg-gold-500 shadow-lg shadow-gold-700/20 hover:scale-[1.03] active:scale-[0.98] transition-all duration-300">
          Xem Thống Kê Chi Tiết
        </a>
        <a href="#timeline" class="px-8 py-4 rounded-xl text-sm font-bold uppercase tracking-wider text-white border border-white/20 hover:border-gold-700 hover:bg-gold-950/20 active:scale-[0.98] transition-all duration-300 glass-panel">
          Hành Trình Sự Nghiệp
        </a>
      </div>

      <!-- Quick Facts -->
      <div class="grid grid-cols-3 gap-6 max-w-md mx-auto lg:mx-0 border-t border-white/10 pt-8">
        <div>
          <span class="block text-2xl md:text-3xl font-display font-extrabold text-gold-700">900+</span>
          <span class="text-xs text-gray-500 uppercase tracking-widest font-sans">Bàn Thắng</span>
        </div>
        <div>
          <span class="block text-2xl md:text-3xl font-display font-extrabold text-white">5</span>
          <span class="text-xs text-gray-500 uppercase tracking-widest font-sans">Quả Bóng Vàng</span>
        </div>
        <div>
          <span class="block text-2xl md:text-3xl font-display font-extrabold text-white">5</span>
          <span class="text-xs text-gray-500 uppercase tracking-widest font-sans">Champions League</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Abstract Graphic Representing CR7 -->
    <div class="lg:col-span-5 flex justify-center relative animate-float">
      <!-- Outer Glowing Ring -->
      <div class="absolute w-[320px] h-[320px] md:w-[420px] md:h-[420px] rounded-full border border-gold-700/20 glow-gold opacity-60"></div>
      
      <!-- Inner Glowing Ring -->
      <div class="absolute w-[280px] h-[280px] md:w-[360px] md:h-[360px] rounded-full border-2 border-dashed border-gold-700/10"></div>

      <!-- Main Visual Container -->
      <div class="relative w-[240px] h-[340px] md:w-[300px] md:h-[420px] rounded-3xl overflow-hidden glass-panel border border-gold-700/30 flex items-center justify-center p-4">
        <!-- Overlay Dark Gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent z-10"></div>
        
        <!-- Symbolic Illustration / Backdrop -->
        <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1579952363873-27f3bade9f55?q=80&w=600&auto=format&fit=crop'); filter: grayscale(100%) contrast(120%) brightness(50%);"></div>

        <!-- Big Shiny Number 7 -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[14rem] md:text-[18rem] font-display font-black text-transparent bg-clip-text bg-gradient-to-b from-gold-700/30 to-transparent pointer-events-none select-none z-0">
          7
        </div>

        <!-- Floating Card Details -->
        <div class="relative z-20 w-full mt-auto text-left">
          <p class="text-gold-700 font-display font-bold text-xs uppercase tracking-widest mb-1">Mã số áo huyền thoại</p>
          <h3 class="text-2xl font-display font-extrabold text-white mb-2">SIÊU SAO ĐẠI DIỆN</h3>
          <p class="text-xs text-gray-400 leading-relaxed font-sans font-light">
            Nhắc đến số 7 là nhắc đến CR7, biểu tượng hoàn mỹ cho tốc độ, sức mạnh, kỹ thuật và bàn thắng.
          </p>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 opacity-60 hover:opacity-100 transition-opacity">
    <span class="text-[10px] uppercase tracking-widest text-gray-500 font-sans">Cuộn xuống</span>
    <a href="#about" class="w-6 h-10 border-2 border-gray-600 rounded-full flex items-start justify-center p-1 cursor-pointer">
      <span class="w-1.5 h-2.5 bg-gold-700 rounded-full animate-bounce"></span>
    </a>
  </div>
</section>
